# Audio (Mono speaker)
persist.vendor.audio.voicecall.speaker.stereo=false
vendor.audio.feature.custom_stereo.enable=false

# Display (90Hz IPS LCD)
vendor.display.svi.config_path=/vendor/etc/svi_config_19720.xml
vendor.display.enable_optimize_refresh=1
ro.vendor.cabc.enable=true
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.set_idle_timer_ms=80
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.use_content_detection_for_refresh_rate=false
ro.surface_flinger.support_kernel_idle_timer=true
debug.sf.frame_rate_multiple_threshold=0

# Fingerprint (Side Capacitive FPS)
ro.vendor.fingerprint.type=side
ro.vendor.fingerprint.supports_gestures=true

